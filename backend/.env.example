# ==============================================================================
# BigWarn Cloud Lakehouse Configuration (.env.example -> copy to .env)
# Automatically syncs Bronze, Silver, and Gold Medallion tables to the Cloud!
# ==============================================================================

# Choose provider: "azure_adls", "cloudflare_r2", "s3", or "local"
BIGWARN_CLOUD_PROVIDER=local

# ------------------------------------------------------------------------------
# OPTION 1: Microsoft Azure Data Lake Storage Gen2 (ADLS Gen2)
# (Free $100 credit with your @student.aiub.edu email via Azure for Students!)
# ------------------------------------------------------------------------------
# Easiest Zero-SDK Setup: Generate a Container SAS URL from Azure Portal -> Storage Account -> Containers -> bigwarn-lakehouse -> Shared access tokens
AZURE_STORAGE_SAS_URL=

# Or via Account Key / Connection String (also used by PySpark abfss://):
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_LAKEHOUSE_CONTAINER=bigwarn-lakehouse

# ------------------------------------------------------------------------------
# OPTION 2: Cloudflare R2 / AWS S3 / MinIO Cloud (S3-Compatible Object Storage)
# (Cloudflare R2 gives 10 GB/month 100% Free Forever with zero egress fees!)
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_LAKEHOUSE_BUCKET=bigwarn-lakehouse
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
