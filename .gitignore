# ==============================================================================
# BigWarn Disruption Streamer & Lakehouse Monorepo .gitignore
# Covers: Python (Scraper/Spark/Lakehouse), Next.js 14 (Frontend/PWA), Kafka & OS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python, Virtual Environments & Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 2. Apache Spark, Delta Lakehouse & Streaming Big Data
# ------------------------------------------------------------------------------
spark-warehouse/
metastore_db/
derby.log
*.parquet
*.orc
*.avro
_delta_log/
.checkpoint/
checkpoint_*/
spark_checkpoints/
*.checkpoint

# Streaming Data Lake Storage (Ignore large bulk crawls & delta tables, preserve folder structure)
backend/data/logs/*.log
backend/data/logs/*.jsonl
backend/data/lakehouse/**
backend/data/seen_urls.json
!backend/data/lakehouse/.gitkeep
!backend/data/logs/.gitkeep

# POC runtime artifacts
news-live-POC/seen_urls.json

# ------------------------------------------------------------------------------
# 3. Node.js & Next.js 14 (Frontend / PWA)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
frontend/.next/
out/
frontend/out/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js telemetry / bundle analysis
.next-analytics
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env*.local
.env.development
.env.production
*.pem
*.key
*.cert

